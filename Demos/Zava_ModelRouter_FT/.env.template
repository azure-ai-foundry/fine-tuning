# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Foundry project (data plane — used for upload, submit, monitor, test)
# ─────────────────────────────────────────────────────────────────────────────
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_OPENAI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Azure resource details (control plane — used for the deployment step only)
# ─────────────────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_RESOURCE_NAME=your-azure-openai-account-name

# Name to give the fine-tuned router deployment (you choose this — must be unique
# within the resource).
AZURE_FINETUNED_DEPLOYMENT_NAME=zava-model-router-ft

