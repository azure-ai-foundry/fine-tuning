# Microsoft Foundry Project Configuration
MICROSOFT_FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Azure OpenAI Configuration (for evaluation model)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Azure Resource Configuration (for model deployment)
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_AOAI_ACCOUNT=<your-foundry-account-name>

# Fine-tuning Configuration
BASE_MODEL=gpt-4.1-mini
TEACHER_MODEL=gpt-4.1
